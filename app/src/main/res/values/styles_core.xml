<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Master parent theme -->
    <style name="Theme.zefio" parent="Theme.Material3.DynamicColors.DayNight" />
    <!-- Adds nicer selector attributes not supported on lollipop -->
    <style name="Theme.zefio.V23" parent="Theme.zefio" />
    <!-- Handles edge-to-edge on other styles variants -->
    <style name="Theme.zefio.V27" parent="Theme.zefio.V23">
        <item name="android:statusBarColor">@color/chrome_translucent</item>
        <item name="android:navigationBarColor">@color/chrome_translucent</item>
    </style>
    <!-- Adds fully transparent system bars -->
    <style name="Theme.zefio.V29" parent="Theme.zefio.V27" />
    <!-- Adds an animated splash screen. -->
    <style name="Theme.zefio.V31" parent="Theme.zefio.V29" />

    <!-- Base theme -->
    <style name="Theme.zefio.Base" parent="Theme.zefio.V31">

        <!-- Material configuration -->
<!--        <item name="colorOutline">@color/overlay_stroke</item>-->
        <item name="toolbarStyle">@style/Widget.zefio.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/Theme.zefio.Dialog</item>
        <item name="sliderStyle">@style/Widget.zefio.Slider</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.zefio.LinearProgressIndicator</item>
        <item name="bottomSheetStyle">@style/Widget.zefio.BottomSheet</item>
        <item name="bottomSheetDialogTheme">@style/Widget.zefio.BottomSheet.Dialog</item>
        <item name="bottomSheetDragHandleStyle">@style/Widget.zefio.BottomSheet.Handle</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.zefio.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.zefio.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.zefio.DisplaySmall</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.zefio.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.zefio.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.zefio.HeadlineSmall</item>

        <item name="textAppearanceTitleLarge">@style/TextAppearance.zefio.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.zefio.TitleMedium
        </item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.zefio.TitleSmall</item>

        <item name="textAppearanceLabelLarge">@style/TextAppearance.zefio.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.zefio.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.zefio.LabelSmall</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.zefio.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.zefio.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.zefio.BodySmall</item>

        <!-- Fix dumb default android behavior -->
        <item name="android:scrollbars">none</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorControlHighlight">@color/sel_compat_ripple</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>

        <!-- Work around hard-coded text highlight colors in the default Material3 theme -->
        <item name="android:textColorHighlight">@color/overlay_text_highlight</item>
        <item name="android:textColorHighlightInverse">@color/overlay_text_highlight_inverse</item>

        <item name="preferenceTheme">@style/PreferenceTheme.zefio</item>
        <item name="preferenceStyle">@style/Preference.zefio</item>
        <item name="preferenceCategoryStyle">@style/Preference.zefio.PreferenceCategory</item>
        <item name="dialogPreferenceStyle">@style/Preference.zefio.DialogPreference</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.zefio.SwitchPreferenceCompat
        </item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.zefio.Toolbar.Navigation</item>
        <item name="actionOverflowButtonStyle">@style/Widget.zefio.Button.Overflow</item>
    </style>

    <!-- Make sure blue is the default style instead of material purple -->
    <style name="Theme.zefio.App" parent="@style/Theme.zefio.Blue" />

    <!--
    Theming widgets is technically possible below Android 12, but I *really* don't care enough
    to bother with it.
    -->
    <style name="Theme.zefio.Widget" parent="@style/Theme.zefio.Blue" />
</resources>